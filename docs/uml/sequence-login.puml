@startuml LifeLine - Diagramme de Séquence : Connexion

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequence {
  ArrowColor #1e3a8a
  LifeLineBorderColor #1e3a8a
  ParticipantBorderColor #1e3a8a
  ParticipantBackgroundColor #e8f4fd
}

title Diagramme de Séquence - Connexion

actor Utilisateur as U
participant "Application\nLifeLine" as App
participant "Firebase Auth" as FB
database "Supabase" as DB

U -> App : Saisir email + mot de passe
App -> FB : Authentifier utilisateur
FB --> App : Retourner idToken

App -> DB : Rechercher utilisateur par firebase_uid
DB --> App : Retourner profil utilisateur

App -> DB : Charger profil médical
DB --> App : Retourner données médicales

App --> U : Connexion réussie + afficher Dashboard

@enduml
